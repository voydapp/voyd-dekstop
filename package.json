{
  "name": "voyd-desktop",
  "version": "1.0.96",
  "description": "VOYD Desktop App",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "publish": "electron-builder --publish always && node scripts/generate-latest-yml.js"
  },
  "build": {
    "appId": "com.voyd.desktop",
    "productName": "VOYD",
    "compression": "maximum",
    "npmRebuild": false,
    "files": [
      "main.js",
      "preload.js",
      ".env",
      "gameDetection.js",
      "overlay-preload.js",
      "overlay.html",
      "source-picker-preload.js",
      "source-picker.html",
      "overlay-renderer.js",
      "app-update.yml",
      "assets/**",
      "node_modules/**",
      "!node_modules/**/test/**",
      "!node_modules/**/*.md",
      "!node_modules/**/LICENSE",
      "!node_modules/**/*.map"
    ],
    "asarUnpack": [
      "node_modules/uiohook-napi/**"
    ],
    "extraResources": [
      {
        "from": "app-update.yml",
        "to": "app-update.yml"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "voydapp",
      "repo": "voyd-dekstop",
      "releaseType": "release"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "VOYD.exe"
    },
    "portable": {
      "artifactName": "VOYD.exe",
      "requestExecutionLevel": "user",
      "unpackDirName": "voyd-app"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    }
  },
  "keywords": [],
  "author": "voydapp",
  "license": "ISC",
  "devDependencies": {
    "@capacitor/cli": "^8.2.0",
    "electron": "^40.8.0",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "@capacitor/android": "^8.2.0",
    "@superhuman/electron-push-receiver": "^2.1.9",
    "electron-updater": "^6.3.9",
    "ps-list": "^9.0.0",
    "uiohook-napi": "^1.5.5"
  },
  "overrides": {
    "protobufjs": "^8.8.0"
  }
}
